store:
  provider: tinydb
  path: data/news_docs.json
  # provider: sqlite
  # path: data/news_docs.sqlite
checkpointing:
  enabled: true
  dir: data/checkpoints
prompts:
  path: "config/prompts"
  default_package: "daily_hybrid_news_cyber_tech_se"
  selected: ""   # (tom => använd default; webapp sätter override per körning)
feeds:
  path: "config/feeds.yaml"
ingest:
  lookback: 1d
  max_items_per_feed: 100
  article_timeout_s: 20
  extraction:
    path: "config/extraction.yaml"
batching:
  # Använd en större del av kontextfönstret per anrop. Dessa värden passar
  # konfigurationer med minst 24k context_window_tokens.
  max_articles_per_batch: 10
  max_chars_per_batch: 18000
  article_clip_chars: 3000
  similarity_enabled: true
  similarity_threshold: 0.78
  embedding_text_chars: 2000
  embedding_max_concurrency: 4
  embedding_instruction: "Represent the specific real-world event described by this article."
  meta_batch_clip_chars: 1500
  meta_sources_clip_chars: 100
  retry_user_clip_chars: 9000
  # En revisionsrunda plus avslutande audit ger bra skydd utan upp till nio
  # extra LLM-anrop per sammanfattning.
  proofread_max_rounds: 1
  topic_max_workers: 4
tagging:
  summary_max_tags: 12
  article_max_tags: 12
  # Minsta cosinuslikhet för att ersätta en föreslagen tagg med en befintlig.
  embedding_replacement_threshold: 0.8
  # Sätt till false för att inte skapa en separat tagg för varje CVE-ID i sammanfattningar.
  summary_include_cve_tags: true
  # LLM får välja befintliga taggar i dessa kategorier, men inte skapa nya.
  llm_new_tag_excluded_categories:
    - DOMAIN_ENTITY
  ml:
    # Första produktionsvarianten använder SGDClassifier på lagrade artikel-embeddings.
    # Lämna avstängd tills ett tillräckligt stort, granskat träningsunderlag finns.
    enabled: false
    algorithm: sgd
    representation: embedding
    categories:
      - DOMAIN_ENTITY
    # Tomt värde ärver embedding_model från den lokala LLM-konfigurationen.
    embedding_model: ""
    embedding_text_chars: 2000
    embedding_instruction: "Represent the topics, industries or sectors, type of information, subjects and geographical regions discussed in this article."
    model_path: data/tagging_ml/domain_entity_sgd_embeddings.joblib
    min_label_support: 5
    min_training_articles: 30
    max_tags_per_article: 20
    threshold: 0.5
    alpha: 0.0001
    random_state: 42
    # Vid nästa taggningskörning jämförs ett corpus-fingeravtryck. Ändrade
    # artikel-taggar leder till full omträning så att även borttagningar lärs om.
    auto_retrain: true
    # Manuella tillägg/borttagningar av artikeltaggar köar en full omträning.
    retrain_on_manual_tag_change: true
  similarity_consistency:
    enabled: true
    similarity_threshold: 0.78
    embedding_text_chars: 2000
    embedding_max_concurrency: 4
    max_shared_tags: 1
long_term_analysis:
  # Aktiveras först efter kalibrering och shadow-körning enligt config/long_term.md.
  enabled: false
  # shadow sparar långtidsresultat men blockerar alltid summary_docs-spegling.
  # Byt uttryckligen till publish först efter godkänd shadow-period.
  mode: shadow
  # Read-only-vyn kan aktiveras separat för granskning av shadow-rapporter.
  ui:
    enabled: false
    # Tillåter explicita, loggade beslut i den skrivbara viewern. Read-only-
    # viewern blockerar alltid dessa POST-anrop även när flaggan är true.
    review_actions_enabled: false
    # Uppåt används strikta delmängder med ett gemensamt taggantal per nivå;
    # nedåt används samma relations invers. Gränserna skyddar stora profilarkiv.
    tag_network_default_levels: 2
    tag_network_max_levels: 6
    tag_network_max_nodes: 250
    tag_network_candidate_limit: 10000
    # Artikelnätverket begränsar antalet grannkluster och hur många av
    # basklustrets medlemskap som får läsas när överlappningen beräknas.
    article_network_default_max_neighbors: 40
    article_network_max_neighbors: 200
    article_network_membership_limit: 5000
  schema_version: 1
  batch_size: 200
  quarantine_retry_limit: 50
  # Egen retention för långtidsdata; 0 stänger av gallringen.
  retention_days: 730
  map_lease_seconds: 1800
  report_lease_seconds: 3600
  llm:
    # cloud utesluter lokala modeller från Map/Reduce-kedjan. Välj local för
    # ren lokal körning eller configured_chain för hela ordinarie kedjan.
    map_provider: cloud
    reduce_provider: cloud
    map_max_output_tokens: 8000
    reduce_max_output_tokens: 2500
  clustering:
    embedding_purpose: similarity
    # Ett medlemskap per artikel och tagg; embeddings delar händelser inom samma tagg.
    # Äldre semantiska kluster behålls som historik och migreras inte automatiskt.
    tag_scope_categories: [DOMAIN_ENTITY, MALWARE, THREAT_ACTOR, SECTOR, VULNERABILITY]
    similarity_threshold: 0.80
    ambiguity_margin: 0.03
    candidate_window_days: 60
    min_shared_tags: 2
    dormant_after_days: 30
    close_after_days: 180
  reconciliation:
    # Förslagspasset är read-only. En sammanslagning kräver identitetsstöd och
    # narrativa artiklar får nämna olika CVE:er för samma händelse.
    auto_merge_similarity: 0.88
    review_similarity: 0.82
    candidate_window_days: 60
    max_review_pairs: 500
  cluster_updates:
    # Atomära enartikelssignaler räknas i trender men får inget eget LLM-anrop.
    min_cluster_members_for_map: 2
    min_pending_articles: 3
    max_update_delay_hours: 24
    max_articles_per_call: 12
    article_clip_chars: 2500
  reports:
    mirror_to_summary_docs: true
    windows_days: [7, 30, 90]
    bucket_days: 7
    forecast_horizon_days: [30, 90]
    min_independent_events_for_trend: 3
    source_concentration_threshold: 0.75
    source_mix_change_threshold: 0.35
    min_snapshot_member_count: 2
    max_clusters: 10000
    max_memberships_per_cluster: 10000
    max_snapshots_per_segment: 5
    max_snapshot_records: 10000
    generation_attempts: 3
  profiles:
    all_profiles:
      enabled: true
      display_name: Samlad analys
      region: Global
      sector: all
      # Jobbet uppdaterar profilerna nedan och återanvänder deras deduplicerade
      # Map-snapshots i den samlade rapporten.
      aggregate_profiles: [healthcare_europe, critical_infrastructure, global_events]
    healthcare_europe:
      enabled: true
      region: Europe
      sector: healthcare
      categories: [Cybersecurity, Dataskydd, Breaches, Sårbarheter]
      priority_tags: [Europe, healthcare]
    critical_infrastructure:
      enabled: true
      region: Global
      sector: critical infrastructure
      categories: [Cybersecurity, Dataskydd, Breaches, Sårbarheter]
      priority_tags: [critical infrastructure, energy, ICS, OT]
    global_events:
      enabled: true
      region: Global
      sector: global events
      categories: [Cybersecurity, Dataskydd, Breaches, Sårbarheter]
      priority_tags: [geopolitics, global]
cleanup:
  enabled: true
  run_every_minutes: 60
  articles_days: 180
  daily_summaries_days: 7
  weekly_summaries_days: 30
  temp_summaries_days: 30
  jobs_days: 90
scheduler:
  enabled: true
  path: "config/schedule.yaml"
  poll_seconds: 20
  timezone: "Europe/Stockholm"
worker:
  log_file: "logs/feedsum_worker.log"
  log_level: "INFO"
  log_max_bytes: 10485760
  log_backup_count: 5
worker_api:
  enabled: false
  host: "127.0.0.1"
  port: 8799
llm:
  - provider: ollama_cloud
    host: https://ollama.com
    model: gemma3:27b-cloud
    # false: välj enbart befintliga DB-taggar och granska ML-förslag före lagring
    allow_new_tags: true
    api_key: CHANGE-ME-CHANGE-ME
    context_window_tokens: 24576
    max_output_tokens: 500
    prompt_safety_margin: 1600
    token_chars_per_token: 2.4
    prompt_too_long_max_attempts: 6
    prompt_too_long_structural_threshold_tokens: 1200
    quota:
      preflight: true
      min_interval_seconds: 2
  - provider: ollama_local
    model: qwen2.5:7b
    allow_new_tags: true
    embedding_model: qwen3-embedding:0.6b
    embedding_dimensions: 1024
    base_url: http://localhost:11434
    max_rps: 1
    timeout_s: 6000
    sock_read_timeout_s: 360
    max_retries: 3
    retry_backoff_s: 2.0
    context_window_tokens: 8192
    max_output_tokens: 500
    prompt_safety_margin: 1600
    token_chars_per_token: 2.4
    prompt_too_long_max_attempts: 6
    prompt_too_long_structural_threshold_tokens: 1200
